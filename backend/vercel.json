{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/chat",
      "dest": "backend/index.js"
    },
    {
      "src": "/(.*)",
      "headers": {
        "content-type": "text/html; charset=utf-8"
      },
      "dest": "frontend/index.html"
    }
  ]
}
